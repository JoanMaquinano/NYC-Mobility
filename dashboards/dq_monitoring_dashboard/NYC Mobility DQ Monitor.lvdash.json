            "displayName": "Batch Month"
          },
          {
            "name": "finished_at",
            "expr": "finished_at",
            "displayName": "Finished At"
          }
        ],
        "measures": [
          {
            "name": "checks_run",
            "expr": "SUM(checks_run)",
            "displayName": "Checks Run"
          },
          {
            "name": "checks_passed",
            "expr": "SUM(checks_passed)",
            "displayName": "Checks Passed"
          },
          {
            "name": "checks_warned",
            "expr": "SUM(checks_warned)",
            "displayName": "Checks Warned"
          },
          {
            "name": "checks_failed",
            "expr": "SUM(checks_failed)",
            "displayName": "Checks Failed"
          },
          {
            "name": "checks_skipped",
            "expr": "SUM(checks_skipped)",
            "displayName": "Checks Skipped"
          },
          {
            "name": "tables_checked",
            "expr": "SUM(tables_checked)",
            "displayName": "Tables Checked"
          }
        ]
      }
    },
