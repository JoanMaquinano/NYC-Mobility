{
  "datasets": [
    {
      "name": "dq_results",
      "displayName": "DQ Results (Current Batch)",
      "config": {
        "version": "1.1",
        "source": "nyc_mobility.nyc_quality.vw_current_batch_dq",
        "dimensions": [
          {
            "name": "layer",
            "expr": "layer",
            "displayName": "Layer"
          },
          {
            "name": "table_name",
            "expr": "table_name",
            "displayName": "Table"
          },
          {
            "name": "check_category",
            "expr": "check_category",
            "displayName": "Check Category"
          },
          {
            "name": "check_name",
            "expr": "check_name",
            "displayName": "Check Name"
          },
          {
            "name": "status",
            "expr": "status",
            "displayName": "Status"
          },
          {
            "name": "batch_month",
            "expr": "batch_month",
            "displayName": "Batch Month"
          }
        ],
        "measures": [
          {
            "name": "check_count",
            "expr": "COUNT(*)",
            "displayName": "Check Count"
          },
          {
            "name": "failed_rows",
            "expr": "SUM(failed_rows)",
            "displayName": "Failed Rows"
          },
          {
            "name": "total_rows",
            "expr": "SUM(total_rows)",
            "displayName": "Total Rows"
          },
          {
            "name": "failed_pct",
            "expr": "AVG(failed_pct)",
            "displayName": "Failed %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "threshold_pct",
            "expr": "AVG(threshold_pct)",
            "displayName": "Threshold %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "dq_rules",
      "displayName": "DQ Rules Catalogue",
      "config": {
        "version": "1.1",
        "source": "nyc_mobility.nyc_quality.dq_rules",
