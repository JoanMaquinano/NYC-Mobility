    },
    {
      "name": "dq_run_log",
      "displayName": "DQ Run Log (Latest)",
      "config": {
        "version": "1.1",
        "source": "nyc_mobility.nyc_quality.vw_latest_dq_run",
        "dimensions": [
          {
            "name": "run_id",
            "expr": "run_id",
            "displayName": "Run ID"
          },
          {
            "name": "run_ts",
