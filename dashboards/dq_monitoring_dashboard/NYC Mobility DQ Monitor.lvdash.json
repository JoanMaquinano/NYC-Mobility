            "displayName": "Rule Description"
          },
          {
            "name": "rationale",
            "expr": "rationale",
            "displayName": "Rationale"
          },
          {
            "name": "denominator_scope",
            "expr": "denominator_scope",
            "displayName": "Denominator Scope"
          },
          {
            "name": "threshold_pct",
            "expr": "threshold_pct",
            "displayName": "Threshold %"
          },
          {
            "name": "warn_pct",
            "expr": "warn_pct",
            "displayName": "Warn %"
          },
          {
            "name": "min_failed_rows",
            "expr": "min_failed_rows",
            "displayName": "Min Failed Rows"
          }
        ],
        "measures": [
